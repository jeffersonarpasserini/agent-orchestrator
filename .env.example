# Application
ORCHESTRATOR_ENV=development
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=8088

# PostgreSQL - replace locally; never commit real credentials
ORCHESTRATOR_DB_PASSWORD=change-me
ORCHESTRATOR_DATABASE_URL=postgresql://agent_orchestrator:change-me@shared-postgres:5432/agent_orchestrator

# Hermes adapter
HERMES_ENDPOINT=http://host.docker.internal:PORT
HERMES_REQUEST_TIMEOUT_SECONDS=120
HERMES_PROFILES_ROOT=~/.hermes/profiles
DEEPSEEK_DAILY_BUDGET_USD=1.00
DEEPSEEK_PILOT_BUDGET_USD=10.00
DEEPSEEK_PILOT_STARTED_AT=2026-08-11T00:00:00-03:00

# DeepSeek technical reserve - specification foundation only; no API key here
DEEPSEEK_RESERVE_MODE=off
DEEPSEEK_RESERVE_KILL_SWITCH=true
DEEPSEEK_RESERVE_PROFILES=
# Required only for a future, explicitly approved enforced mode
# DEEPSEEK_RESERVE_DAILY_BUDGET_USD=1.00
# DEEPSEEK_RESERVE_MONTHLY_BUDGET_USD=10.00

# OpenTelemetry / Phoenix
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces

# OpenObserve pilot - use a dedicated strong password; never commit real values
OPENOBSERVE_ROOT_EMAIL=observability-admin@example.invalid
OPENOBSERVE_ROOT_PASSWORD=replace-with-a-long-random-secret

# Intentionally absent: OPENAI_API_KEY
